# Admin panel qaysi backenddan ma'lumot oladi.
# Bo'sh qoldirilsa — admin panel bilan bir domen/port (docker-compose'dagi nginx
# /api va /media ni backendga uzatadi). Alohida domen bo'lsa to'liq manzil:
#   VITE_API_URL=https://api.avtotest-tayyorlov.uz
# Eslatma: qiymat build paytida kodga yoziladi — o'zgartirgach qayta build qiling.
VITE_API_URL=

# Faqat `npm run dev` uchun: /api va /media so'rovlari shu backendga proxy qilinadi.
DEV_BACKEND_URL=http://127.0.0.1:9005
