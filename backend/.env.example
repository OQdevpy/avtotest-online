# Bu fayldan nusxa oling: cp .env.example .env

# --- Majburiy ---------------------------------------------------------------
# DEBUG=False bo'lganda SECRET_KEY va ALLOWED_HOSTS majburiy.
# Kalit yaratish: python -c 'from django.core.management.utils import get_random_secret_key as k; print(k())'
SECRET_KEY=
DEBUG=False
ALLOWED_HOSTS=localhost,127.0.0.1

# Baza faqat DATABASE_URL orqali sozlanadi. Parolda @ : / bo'lsa ularni
# %40 %3A %2F bilan yozing. docker-compose bu qiymatni o'zi yasaydi.
DATABASE_URL=postgresql://postgres:parol@localhost:5432/avtotest

# Eski avtotest bazasi (faqat o'qiladi). Yangi ilovada Telegram orqali kirgan
# raqam bu bazada bo'lmasa, hisob (ism, til, PRO) shu bazadan ko'chiriladi.
# Bo'sh qoldirilsa — o'chirilgan.
LEGACY_DATABASE_URL=

# docker-compose uchun (compose DATABASE_URL ni shulardan yig'adi)
DB_NAME=avtotest
DB_USER=postgres
DB_PASSWORD=
WEB_PORT=9005

# --- Mijozlar ---------------------------------------------------------------
# CORS_ALLOW_ALL default False. Kerakli originlarni sanab bering.
CORS_ALLOW_ALL=False
CORS_ALLOWED_ORIGINS=https://prava777.uz
CSRF_TRUSTED_ORIGINS=https://prava777.uz

# --- Telegram (yagona kirish yo'li) -------------------------------------------
TELEGRAM_BOT_TOKEN=
# Token egasi bo'lgan botning @nomi (t.me havolasi uchun).
# Dev/testda sinov botini ishlating: production boti bilan bir vaqtda
# bitta token ikki joyda polling qila olmaydi.
TELEGRAM_BOT_USERNAME=prava777Robot
# Botdagi «Ilovaga qaytish» tugmasi ochadigan sahifa (bo'sh — tugma chiqmaydi)
APP_RETURN_URL=https://mobile.prava777.uz/api/v1/auth/telegram/return/

# --- Push bildirishnomalar (FCM) ---------------------------------------------
# Firebase → Project settings → Service accounts → Generate new private key.
# Faylni serverda <loyiha>/firebase/service-account.json ga qo'ying (compose
# uni /run/secrets/firebase ga ulaydi). Bo'sh — push yuborilmaydi.
FIREBASE_CREDENTIALS_FILE=/run/secrets/firebase/service-account.json

# --- Boshqa -----------------------------------------------------------------
TIME_ZONE=Asia/Tashkent
MEDIA_ROOT=
