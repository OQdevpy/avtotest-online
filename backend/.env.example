# Bu fayldan nusxa oling: cp .env.example .env

# --- Majburiy ---------------------------------------------------------------
# DEBUG=False bo'lganda SECRET_KEY va ALLOWED_HOSTS majburiy.
# Kalit yaratish: python -c 'from django.core.management.utils import get_random_secret_key as k; print(k())'
SECRET_KEY=
DEBUG=False
ALLOWED_HOSTS=localhost,127.0.0.1

# Baza faqat DATABASE_URL orqali sozlanadi. Parolda @ : / bo'lsa ularni
# %40 %3A %2F bilan yozing. docker-compose bu qiymatni o'zi yasaydi.
DATABASE_URL=postgresql://postgres:parol@localhost:5432/avtotest

# docker-compose uchun (compose DATABASE_URL ni shulardan yig'adi)
DB_NAME=avtotest
DB_USER=postgres
DB_PASSWORD=
WEB_PORT=9005

# --- Mijozlar ---------------------------------------------------------------
# CORS_ALLOW_ALL default False. Kerakli originlarni sanab bering.
CORS_ALLOW_ALL=False
CORS_ALLOWED_ORIGINS=https://avtotest-tayyorlov.uz
CSRF_TRUSTED_ORIGINS=https://avtotest-tayyorlov.uz

# --- Ijtimoiy kirish --------------------------------------------------------
# Bo'sh qoldirilsa o'sha provayder orqali kirish ochilmaydi (tekshiruvsiz
# ishlash imkoni yo'q).
APPLE_BUNDLE_ID=
GOOGLE_CLIENT_IDS=
TELEGRAM_BOT_TOKEN=

# --- Boshqa -----------------------------------------------------------------
TIME_ZONE=Asia/Tashkent
MEDIA_ROOT=
