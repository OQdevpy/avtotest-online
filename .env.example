# Docker Compose uchun muhit o'zgaruvchilari
# Bu fayldan nusxa oling: cp .env.example .env

# Baza sozlamalari
DB_NAME=avtotest
DB_USER=postgres
DB_PASSWORD=

# Web port
WEB_PORT=9005

# Backend API porti — faqat 127.0.0.1 da ochiladi (tizim nginx'i shu yerga proxy qiladi)
API_PORT=8010

# Admin panel qaysi backenddan oladi (bo'sh — shu nginx/port orqali, tavsiya)
ADMIN_API_URL=
